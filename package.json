{
  "name": "tienda-ropa",
  "version": "0.1.0",
  "description": "Base de e-commerce de ropa: catálogo con talles y colores, carrito, checkout con Mercado Pago y panel de administración",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "db:init": "node backend/db/init.js",
    "db:seed": "node backend/db/seed.js",
    "db:setup": "node backend/db/init.js && node backend/db/seed.js",
    "db:seed:danza": "node backend/db/seed-danza.js",
    "demo": "node scripts/construir-demo.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "mercadopago": "^3.6.2",
    "pg": "^8.13.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
