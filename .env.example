# =====================================================
# Copiá este archivo como ".env" y completalo.
# NUNCA subas el .env a GitHub (ya está en .gitignore).
# =====================================================

# --- General ---
NODE_ENV=development
PORT=3000
# En producción: la URL pública con https (ej: https://mitienda.com.ar)
FRONTEND_URL=http://localhost:3000

# --- Base de datos ---
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/tienda_ropa

# --- Panel de administración ---
ADMIN_USER=admin
# Usá una contraseña larga (12+ caracteres)
ADMIN_PASSWORD=cambiar-esta-password
# String largo y aleatorio. Generalo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- Mercado Pago ---
# https://www.mercadopago.com.ar/developers/panel
MP_ACCESS_TOKEN=
# Panel de MP > Tus integraciones > Webhooks > "Clave secreta"
# En producción es OBLIGATORIA (el servidor no arranca sin ella).
MP_WEBHOOK_SECRET=

# --- Envíos ---
# Costo fijo del envío a domicilio (en pesos)
ENVIO_COSTO=7000
# Envío gratis desde este subtotal (0 = nunca)
ENVIO_GRATIS_DESDE=150000
# Si se completa, se ofrece "Retiro en local" con esta dirección
RETIRO_DIRECCION=

# --- Mails (Resend: https://resend.com) ---
# Se usa una API por HTTPS en vez de SMTP: algunos hostings
# (como el plan gratis de Render) bloquean los puertos SMTP.
# Si queda vacío, los mails se muestran en la consola.
RESEND_API_KEY=
MAIL_FROM=Tienda <ventas@tudominio.com>
# A dónde llegan los avisos de nuevas ventas y alertas
MAIL_TIENDA=

# --- Datos del negocio (pie de página) ---
NEGOCIO_NOMBRE=TU MARCA
NEGOCIO_WHATSAPP=
NEGOCIO_INSTAGRAM_URL=
